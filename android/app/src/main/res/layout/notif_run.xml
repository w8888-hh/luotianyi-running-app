<?xml version="1.0" encoding="utf-8"?>
<!-- 运动常驻通知条：对齐 Salt Player 的媒体样式（标题 / 副标题 / 图标按钮行）。
     RemoteViews 只能用系统允许的控件；文字用 Material.Notification 样式，深浅色模式自动适配。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_app_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_notif"
            android:tint="@color/notif_fg"
            android:contentDescription="app" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:text="洛天依陪跑" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        style="@android:style/TextAppearance.Material.Notification"
        android:text="时长 00:00" />

    <TextView
        android:id="@+id/notif_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        style="@android:style/TextAppearance.Material.Notification.Line2"
        android:text="♪ 未导入音乐" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 音乐控制组 -->
        <ImageButton
            android:id="@+id/notif_prev"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_n_prev"
            android:tint="@color/notif_fg"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="上一首" />

        <ImageButton
            android:id="@+id/notif_play"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_n_play"
            android:tint="@color/notif_fg"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="播放" />

        <ImageButton
            android:id="@+id/notif_next"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_n_next"
            android:tint="@color/notif_fg"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="下一首" />

        <!-- 与音乐控制组之间留一道细缝，区分「音乐」和「运动」两组。
             用 ImageView 而不是裸 View：RemoteViews 的控件白名单里没有 android.view.View，
             部分 ROM 上会 inflate 失败导致通知条出不来。 -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@color/notif_fg_secondary"
            android:contentDescription="分隔" />

        <!-- 运动控制组：暂停/开始运动 + 结束运动 -->
        <ImageButton
            android:id="@+id/notif_run"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_n_pause"
            android:tint="@color/notif_fg"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="暂停运动" />

        <ImageButton
            android:id="@+id/notif_stop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_n_close"
            android:tint="@color/notif_fg"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="结束运动" />
    </LinearLayout>
</LinearLayout>
